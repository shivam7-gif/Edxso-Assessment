# ==========================================
# EDXSO Automated Micro-Influencer Outreach
# Environment Configuration
# ==========================================

# YouTube Data API v3 Key (Required for live discovery)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Groq API Key (Required for AI personalization)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (Optional, defaults to openai/gpt-oss-120b)
# Supported options: openai/gpt-oss-120b, llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-120b

# Outreach Sending Mode: 'simulation' or 'smtp' (Default: simulation)
SEND_MODE=simulation

# SMTP Configuration (Required only when SEND_MODE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# Database Connection (Optional, defaults to sqlite:///data/influencers.db)
DATABASE_URL=sqlite:///data/influencers.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
